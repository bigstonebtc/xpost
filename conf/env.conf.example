# ==========================================
# xpost 設定ファイル
# このファイルをコピーして env.conf を作成してください:
#   cp conf/env.conf.example conf/env.conf
# ==========================================

# --- データベース ---
POSTGRES_USER=xpost
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xpost
DATABASE_URL=postgresql://xpost:changeme@db:5432/xpost

# --- 認証 ---
# ログインパスワード（admin ユーザー用）
ADMIN_PASSWORD=changeme
# JWT署名キー（長いランダム文字列を設定してください）
SECRET_KEY=change-this-to-a-long-random-string

# --- X (Twitter) API ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=

# --- 機能フラグ ---
# 旧ニュース機能（RSS自動取得）のオン・オフ。true にしてコンテナ再起動で復活。
LEGACY_NEWS_FEATURE_ENABLED=false

# --- Tor 経由投稿 ---
# X への投稿を Tor 経由にするか（tor / direct）。Web UI から実行時に切替可能
# （切替は再起動でこの値に戻る）
POSTING_MODE=tor
TOR_PROXY=socks5h://tor:9050
TOR_TIMEOUT=60
