# ==========================================
# xpost ユーザー設定ファイル テンプレート
#
# 共有プログラムモードでは、このファイルは /home/<user>/xpost/conf/env.conf
# としてユーザーごとに配置される（setup_user.sh が初回コピーする）。
# ユーザー間で完全に独立しており、他ユーザーの設定には一切影響しない。
# ==========================================

# ═════ ユーザーが個別に設定する部分 ═════

# --- X (Twitter) API ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=

# --- 機能フラグ（ユーザーが個別設定可能） ---
# 旧ニュース機能（RSS自動取得）のオン・オフ
# true にしてバックエンド再起動で復活
LEGACY_NEWS_FEATURE_ENABLED=false

# --- Tor 経由投稿 ---
# X への投稿を Tor 経由にするか（tor / direct）
# Web UI から実行時に切替可（バックエンド再起動でこの値に戻る）
# Torコンテナ自体は全ユーザー共有のため、TOR_PROXY / TOR_TIMEOUT は
# 通常どのユーザーも同じ値のままでよい。
POSTING_MODE=tor
TOR_PROXY=socks5h://tor:9050
TOR_TIMEOUT=60

# ═════ 以下は setup_user.sh が自動生成する（手動で編集しないこと） ═════
# ADMIN_PASSWORD_HASH= （bcryptハッシュ化。ログインパスワード）
# SECRET_KEY= （JWT署名鍵。ユーザーごとに独立したランダム値）
